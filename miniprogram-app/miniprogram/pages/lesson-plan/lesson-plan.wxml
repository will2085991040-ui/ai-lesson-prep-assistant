<!-- pages/lesson-plan/lesson-plan.wxml - 智能备课 -->
<view class="page {{result ? 'has-fixed-bar' : ''}}">

  <!-- 表单卡片 -->
  <view class="card">
    <!-- 学科 -->
    <picker mode="selector" range="{{subjects}}" value="{{indexes.subjectIndex}}" bindchange="onSubjectChange">
      <view class="form-item">
        <view class="form-label required">学科</view>
        <view class="form-value {{form.subject ? '' : 'form-placeholder'}}">{{form.subject || '请选择学科'}}<view class="form-arrow"></view></view>
      </view>
    </picker>

    <!-- 年级 -->
    <picker mode="selector" range="{{grades}}" value="{{indexes.gradeIndex}}" bindchange="onGradeChange">
      <view class="form-item">
        <view class="form-label required">年级</view>
        <view class="form-value {{form.grade ? '' : 'form-placeholder'}}">{{form.grade || '请选择年级'}}<view class="form-arrow"></view></view>
      </view>
    </picker>

    <!-- 教材（可选） -->
    <picker mode="selector" range="{{textbookNames}}" value="{{indexes.textbookIndex}}" bindchange="onTextbookChange">
      <view class="form-item">
        <view class="form-label">教材</view>
        <view class="form-value {{form.textbook ? '' : 'form-placeholder'}}">{{form.textbook || '请选择教材（可选）'}}<view class="form-arrow"></view></view>
      </view>
    </picker>

    <!-- 课型 -->
    <picker mode="selector" range="{{lessonTypes}}" value="{{indexes.lessonTypeIndex}}" bindchange="onLessonTypeChange">
      <view class="form-item">
        <view class="form-label">课型</view>
        <view class="form-value">{{form.lessonType}}<view class="form-arrow"></view></view>
      </view>
    </picker>

    <!-- 教学风格 -->
    <picker mode="selector" range="{{styles}}" value="{{indexes.styleIndex}}" bindchange="onStyleChange">
      <view class="form-item">
        <view class="form-label">教学风格</view>
        <view class="form-value">{{form.style}}<view class="form-arrow"></view></view>
      </view>
    </picker>

    <!-- 课题 -->
    <view class="form-item">
      <view class="form-label required">课题</view>
      <input class="form-input" placeholder="请输入课题，如：荷塘月色" placeholder-class="form-placeholder" value="{{form.topic}}" bindinput="onTopicInput" />
    </view>

    <!-- 课时 -->
    <view class="form-item">
      <view class="form-label">课时</view>
      <input class="form-input" type="number" value="{{form.hours}}" bindinput="onHoursInput" />
    </view>

    <!-- 学情 -->
    <view class="form-item form-item-column">
      <view class="form-label">学情</view>
      <textarea class="form-textarea" placeholder="如：学生已掌握分数加减法，部分学生计算粗心" placeholder-class="form-placeholder" value="{{form.studentInfo}}" bindinput="onStudentInput"></textarea>
    </view>
  </view>

  <!-- 生成按钮 -->
  <view class="card">
    <view class="btn btn-primary" hover-class="btn-hover" bindtap="onGenerate">✨ 生成完整教案</view>
  </view>

  <!-- 结果区 -->
  <block wx:if="{{result}}">
    <!-- 结果头部：标题 + 重新生成 -->
    <view class="result-header">
      <view class="section-title result-title">生成结果</view>
      <view class="btn btn-ghost regen-btn" hover-class="btn-hover" bindtap="onGenerate">🔄 重新生成</view>
    </view>

    <!-- 8 大模块折叠面板 -->
    <view class="card">
      <collapsible-section
        wx:for="{{sections}}"
        wx:key="number"
        title="{{item.title}}"
        number="{{item.number}}"
        open="{{item.open}}">
        <text class="content-text" user-select>{{item.text}}</text>
      </collapsible-section>
    </view>
  </block>

  <!-- 底部固定操作栏 -->
  <view wx:if="{{result}}" class="fixed-bar">
    <view class="btn btn-plain bar-btn" hover-class="btn-hover" bindtap="onSave">💾 保存</view>
    <view class="btn btn-ghost bar-btn" hover-class="btn-hover" bindtap="onGoPPT">🎨 生成课件</view>
    <view class="btn btn-primary bar-btn" hover-class="btn-hover" bindtap="onCopy">📋 复制全文</view>
  </view>

  <!-- AI 生成全屏 loading -->
  <loading-ai show="{{generating}}" text="AI正在备课中..." subText="正在调用豆包大模型，预计 10-30 秒" />
</view>
