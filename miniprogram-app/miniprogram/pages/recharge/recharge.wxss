/* pages/recharge/recharge.wxss - 充值中心样式 */

/* ==================== 余额卡 ==================== */
.balance-card {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #1677FF 0%, #3D8EFF 100%);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.28);
  color: #FFFFFF;
}
.balance-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.balance-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}
.balance-num {
  margin-top: 12rpx;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
}
.balance-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ==================== 卡片标题 ==================== */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
  margin-bottom: 4rpx;
}

/* ==================== 兑换码充值 ==================== */
.redeem-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.redeem-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1F2329;
  box-sizing: border-box;
}
.redeem-btn {
  width: 200rpx;
  height: 80rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

/* ==================== 充值套餐 ==================== */
.package-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F2F3F5;
}
.package-item:last-child {
  border-bottom: none;
}
.package-info {
  display: flex;
  align-items: baseline;
  min-width: 0;
}
.package-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2329;
}
.package-credits {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #86909C;
}
.package-btn {
  width: 200rpx;
  height: 64rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* ==================== 积分明细 ==================== */
.txn-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}
.txn-item:last-child {
  border-bottom: none;
}
.txn-main {
  flex: 1;
  min-width: 0;
}
.txn-remark {
  font-size: 28rpx;
  color: #1F2329;
}
.txn-time {
  margin-top: 4rpx;
}
.txn-credits {
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.txn-empty {
  padding: 80rpx 0 40rpx;
}

/* ==================== 底部占位 ==================== */
.footer-space {
  height: 40rpx;
}
