/* pages/ppt-outline/ppt-outline.wxss - 课件大纲样式 */
.page {
  padding-bottom: 40rpx;
}

/* 页数：label 与 slider 上下排列 */
.form-item-column {
  flex-direction: column;
  align-items: flex-start;
}
.slider-row {
  width: 100%;
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.slider {
  flex: 1;
  margin: 0;
}
.pages-num {
  width: 140rpx;
  text-align: right;
  font-size: 26rpx;
  color: #1677FF;
  flex-shrink: 0;
}

/* ==================== 结果头部 ==================== */
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 24rpx 20rpx;
}
.result-title {
  margin: 0;
}
.regen-btn {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ==================== 幻灯片卡片 ==================== */
.slide-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}
.slide-item:last-child {
  border-bottom: none;
}
.slide-badge {
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1677FF;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.slide-body {
  flex: 1;
  min-width: 0;
}
.slide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
  margin-bottom: 8rpx;
}
.slide-tip {
  margin-top: 6rpx;
}

/* ==================== 课件封面 ==================== */
.cover-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
  margin-bottom: 16rpx;
}
.cover-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.cover-empty {
  font-size: 24rpx;
  color: #86909C;
  padding: 24rpx 0;
}
.cover-btn {
  height: 72rpx;
  font-size: 27rpx;
}
