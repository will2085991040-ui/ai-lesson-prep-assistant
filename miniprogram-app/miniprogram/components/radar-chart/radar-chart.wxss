/* radar-chart.wxss - 原生 Canvas 雷达图组件样式 */
.radar-wrap {
  width: 100%;
  padding: 10rpx 0 4rpx;
}

.radar-canvas {
  width: 100%;
  height: 480rpx;
}

/* 图例列表 */
.legend {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  width: 50%;
  padding: 10rpx 0;
  box-sizing: border-box;
}
.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1677FF;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.legend-name {
  font-size: 24rpx;
  color: #4E5969;
}
.legend-score {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #1677FF;
  font-weight: 600;
}
