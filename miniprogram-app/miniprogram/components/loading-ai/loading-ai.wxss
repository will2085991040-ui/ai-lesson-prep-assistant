/* loading-ai.wxss - 全屏 AI 生成加载动画样式 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card {
  width: 420rpx;
  padding: 64rpx 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
}

/* 旋转圆环 */
.spinner {
  width: 96rpx;
  height: 96rpx;
  border: 8rpx solid #E8F3FF;
  border-top-color: #1677FF;
  border-radius: 50%;
  animation: ai-spin 0.9s linear infinite;
}

/* 旋转动画关键帧 */
@keyframes ai-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.text {
  margin-top: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #86909C;
}
