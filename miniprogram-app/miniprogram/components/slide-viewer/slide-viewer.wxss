/* slide-viewer.wxss - 全屏课件放映组件样式（小视频/小动画体验） */
/* 组件样式隔离，全部样式在本文件内自建 */

/* 全屏遮罩（深色放映背景） */
.viewer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: #0F172A;
  display: flex;
  flex-direction: column;
}

/* ==================== 顶部栏 ==================== */
.viewer-top {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}
.viewer-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
}
.viewer-exit {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 32rpx;
  color: #FFFFFF;
  font-size: 26rpx;
}
.viewer-hover {
  opacity: 0.7;
}

/* ==================== 自动播放提示（顶部栏下方） ==================== */
.auto-tip {
  padding: 0 24rpx 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ==================== swiper 主体（flex:1 占满中间） ==================== */
.swiper {
  flex: 1;
  width: 100%;
  min-height: 0;
}

/* 翻页入场动画容器（整页包裹，当前页播放 slideIn） */
.slide-panel {
  height: 100%;
}
.slide-enter {
  animation: slideIn 0.45s ease both;
}
@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(6%);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* 单页：整页纵向布局 */
.slide-page {
  height: 100%;
  box-sizing: border-box;
  padding: 16rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部大标题（居中，含页码角标） */
.page-title-row {
  position: relative;
  padding: 16rpx 80rpx;
  text-align: center;
}
.page-badge {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  color: #FFFFFF;
  font-size: 24rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
  word-break: break-all;
}

/* 中部配图区（图片或蓝色渐变占位块） */
.slide-visual {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Ken Burns 动态配图：外层裁剪容器（overflow hidden），内层图片缓慢缩放平移，模拟视频运镜 */
.kb-wrap {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 16rpx;
}
.kb-wrap .slide-img {
  width: 100%;
  height: 100%;
  animation: kbA 14s ease-in-out infinite alternate;
}
.kb-b .slide-img {
  animation: kbB 14s ease-in-out infinite alternate;
}
@keyframes kbA {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.12) translate(1.5%, -1.5%);
  }
}
@keyframes kbB {
  from {
    transform: scale(1.12) translate(-1.5%, 1.5%);
  }
  to {
    transform: scale(1);
  }
}

.slide-placeholder {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1677FF 0%, #3D8EFF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.placeholder-text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.8;
  text-align: center;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 下方要点区（白色反色正文） */
.slide-content {
  margin-top: 20rpx;
  max-height: 240rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ==================== 讲解词面板（浅色底深色字，最多 6 行滚动） ==================== */
.notes-panel {
  margin: 0 24rpx 16rpx;
  max-height: 280rpx;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}
.notes-text {
  color: #1F2329;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ==================== 底部进度条（自动播放时 5 秒动画） ==================== */
.progress-track {
  height: 6rpx;
  margin: 0 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 3rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #1677FF;
  border-radius: 3rpx;
}
.progress-anim {
  animation: progressRun 5s linear;
}
@keyframes progressRun {
  from {
    width: 0;
  }
  to {
    width: 100%;
  }
}

/* ==================== 底部固定栏 ==================== */
.viewer-bottom {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.page-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}
/* 自动播放开关（播放中高亮为主色） */
.play-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-size: 24rpx;
}
.play-btn-active {
  background: #1677FF;
  color: #FFFFFF;
}
.notes-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-size: 24rpx;
}
.nav-group {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
}
.nav-btn {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #1677FF;
  color: #FFFFFF;
  font-size: 24rpx;
}
